datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider   = "prisma-client-js"
  engineType = "wasm"
}

model Scan {
  id        String   @id @default(uuid())
  product   String   // 'burger', 'steak', 'kebab', 'ribs', etc.
  source    String   @default("direct") // 'qr' or 'direct'
  createdAt DateTime @default(now())
}

model Rating {
  id        String   @id @default(uuid())
  product   String   // 'burger', 'steak', 'kebab', 'ribs', etc.
  stars     Int      // 1 to 5
  comment   String?  @default("")
  createdAt DateTime @default(now())
}

model Lead {
  id        String   @id @default(uuid())
  name      String   @default("")
  contact   String   // phone number
  promoCode String   // generated code
  createdAt DateTime @default(now())
}

model OrderClick {
  id        String   @id @default(uuid())
  product   String
  platform  String   // 'talabat', 'careem', 'website', 'phone'
  createdAt DateTime @default(now())
}

model Recipe {
  id               String   @id // e.g. 'burger', 'steak', 'kebab', 'ribs', 'tenderloin', 'kofta', 'awsal', 'smash'
  productId        String?  @default("")
  title            String
  category         String
  icon             String   @default("") // Custom emoji like 🥩, 🍗, 🍔, 🍢, 🍖
  imageUrl         String   @default("") // Real recipe image URL
  meatType         String   @default("meat") // 'meat' or 'chicken'
  cuisine          String   @default("arabic") // 'arabic' or 'international'
  description      String
  prepTime         String
  cookTime         String
  difficulty       String
  videoUrl         String   @default("")
  videoPlaceholder String   @default("")
  ingredients      String   // JSON stringified array of ingredients
  instructions     String   // JSON stringified array of instructions
  tips             String   // JSON stringified array of tips
  marinade         String
  doneness         String?  // JSON stringified array of doneness objects
  recommendedWeights String? // JSON stringified object mapping group sizes to recommended weights
  updatedAt        DateTime @updatedAt
}

model Package {
  id          String   @id // e.g. "group-1", "group-2", "group-3", "group-4", "group-5"
  name        String
  description String   @default("")
  kebab       String   @default("") // Recommended kebab amount (e.g. "500g")
  ribs        String   @default("") // Recommended ribs amount (e.g. "300g")
  burger      String   @default("") // Recommended burger amount (e.g. "2 حبة")
  steak       String   @default("") // Recommended steak amount (e.g. "1 حبة")
  notes       String   @default("") // Extra details or suggestions
  updatedAt   DateTime @updatedAt
}

model SiteSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model LoyaltyCard {
  id           String   @id @default(uuid())
  phone        String   @unique  // رقم الهاتف (المعرّف الأساسي للعميل)
  name         String   @default("")
  points       Int      @default(0) // رصيد النقاط الحالي
  totalEarned  Int      @default(0) // إجمالي النقاط المكتسبة على مر الوقت
  rewardCode   String   @default("") // كود الخصم الفريد عند بلوغ 10 نقاط
  rewardUsed   Boolean  @default(false) // هل تم استخدام كود الخصم؟
  lastScanAt   DateTime? // آخر وقت مسح لمنع التكرار
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Product {
  id        String   @id
  name      String
  weight    String   @default("")
  icon      String   @default("🥩")
  imageUrl  String   @default("")
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
